frontend/src/**/*.js.map
frontend/*.log
frontend/vite.config.js
frontend/vite.config.d.ts
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# 4. Local Binaries & Runtime Cache
video_studio.exe
clipforge.exe
*.exe
*.old
video_studio.exe.WebView2/
*.WebView2/
*.pdb

# 5. Media Downloads & Generated Working Files
/downloads/
concat_list_*.txt
drawtext_overlay_*.txt

# 6. OS & IDE Metadata
.DS_Store
Thumbs.db
desktop.ini
*.tmp
*.bak
*.swp
.idea/
.vscode/
