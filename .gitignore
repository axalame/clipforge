*.local.json
.env
.env.*
!.env.example
*.cookies.txt
cookies.txt

# 2. Rust & Cargo Build Artifacts
/target/
**/*.rs.bk
Cargo.lock.temp

# 3. Node & Frontend Artifacts
/frontend/node_modules/
/frontend/dist/
